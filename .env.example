# INDUSTRIA AI - Environment Configuration Template
# Copy this file to .env and configure local values as needed.
# NOTE: the backend reads real environment variables (it does not parse .env itself): export them,
# or pass the file with `docker compose --env-file .env` / `env_file:` in docker-compose.yml.
# NEVER commit the actual .env file to version control.

# Application Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
PROJECT_NAME="INDUSTRIA AI"

# ML Pipeline Configuration
ML_DATASET_RAW_DIR=ml/datasets/raw
ML_DATASET_PROCESSED_DIR=ml/datasets/processed
ML_ARTIFACTS_DIR=ml/artifacts
ML_RANDOM_STATE=42

# Backend API Configuration (Stage 5)
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
# Single-organisation mode (PRD v1.2 §8.1). Keep false unless multi-tenant registration is intended.
MULTI_ORG_ENABLED=false

# Database Configuration (Neon PostgreSQL)
# For Neon connection pooling, use the pooled endpoint (-pooler) with sslmode=require:
# postgresql+psycopg2://<user>:<password>@<ep-name>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://username:password@ep-name-pooler.region.aws.neon.tech/neondb?sslmode=require

# Frontend Configuration (Stage 6)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Authentication Configuration (Hybrid Mode)
# When provided, the frontend authenticates against Supabase Auth (GoTrue)
# and the FastAPI backend verifies Supabase JWTs and provisions user/org tenancy.
# When omitted, the platform runs in Local Development Auth mode.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

